# Required: random shared token used by the CFSM-SAO admin UI to call this proxy.
PROBE_PROXY_TOKEN=replace-with-a-long-random-secret
# Required: exact origin of the CFSM-SAO site, e.g. https://status.example.com
PROBE_ALLOWED_ORIGINS=https://status.example.com
PORT=8787

# Provider credentials are server-side only. Never put these in Vite variables or theme settings.
TCPTEST_API_KEY=
BOCE_API_KEY=

# Optional limits
PROBE_MAX_NODES=30
PROBE_REQUEST_TIMEOUT_MS=15000
PROBE_RESULT_TTL_MS=900000
